@router.get("/collections/{name}/index-config", response_model=CollectionIndexConfigResponse)
async def get_collection_index_config(name: str):
    """Get the current index configuration for a collection."""
    db = SharedSession()
    try:
        # Get the knowledge source
        record = KnowledgeSourceRepo.get(db, name)
        if not record:
            raise HTTPException(status_code=404, detail=f"Collection '{name}' not found")
        
        # Get or create index config
        from rag_shared.models import CollectionIndexConfig
        config = db.query(CollectionIndexConfig).filter(
            CollectionIndexConfig.collection_name == record.collection_name
        ).first()
        
        if not config:
            # Create default config
            config = CollectionIndexConfig(
                collection_name=record.collection_name,
                enable_vector_index="true",
                enable_sparse_index="false", 
                enable_graph_index="false",
                enable_metadata_index="true",
                enable_memory_index="false",
            )
            db.add(config)
            db.commit()
            db.refresh(config)
        
        return CollectionIndexConfigResponse(
            collection_name=config.collection_name,
            enable_vector_index=config.enable_vector_index.lower() == "true",
            enable_sparse_index=config.enable_sparse_index.lower() == "true",
            enable_graph_index=config.enable_graph_index.lower() == "true",
            enable_metadata_index=config.enable_metadata_index.lower() == "true",
            enable_memory_index=config.enable_memory_index.lower() == "true",
            vector_index_config=config.vector_index_config or {},
            sparse_index_config=config.sparse_index_config or {},
            graph_index_config=config.graph_index_config or {},
            metadata_index_config=config.metadata_index_config or {},
            memory_index_config=config.memory_index_config or {},
        )
    except KnowledgeSourceNotFoundError as exc:
        raise HTTPException(status_code=404, detail=str(exc)) from exc
    finally:
        db.close()


